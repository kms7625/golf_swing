# docker-compose용 환경변수 — .env로 복사해 채우세요 (.env는 커밋 금지)

# 인증 토큰 서명 키 — 필수. 예: openssl rand -hex 32
JWT_SECRET=

# DB — 비우면 SQLite(/data 볼륨). Supabase로 전환 시:
# DATABASE_URL=postgresql+psycopg://postgres:비밀번호@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# 프론트가 호출할 API 주소 (웹 빌드에 새겨짐 — 도메인 확정 후 변경)
VITE_API_BASE=http://localhost:8010

# 브라우저 오리진 허용 목록 (쉼표 구분)
CORS_ORIGINS=http://localhost:8080

# AI 코칭 서버측 키 — 최소 1개(Gemini 권장, 무료 티어)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 업로드 상한(MB) / 회원별 월 무료 코칭 횟수
MAX_UPLOAD_MB=200
FREE_COACHING_PER_MONTH=10
